u5217\u8868\u3002\u4fdd\u7559\u539f\u4eba\u6570\u3001\u96be\u5ea6\u548c\u7279\u6b8a\u6a21\u5f0f\uff1b\u7279\u6b8a\u6a21\u5f0f\u5141\u8bb8\u6309\u539f\u8bf4\u660e\u4efb\u610f\u65f6\u673a\u51fa+4\u53ca\u53e0\u52a0+2/+4\uff0c\u672a\u4fee\u6539\u6b63\u5e38/\u7279\u6b8a\u4e24\u5957\u5224\u5b9a\u3002\u5b9e\u6d4b\u8303\u56f4\u4ee5\u6700\u7ec8\u8fd0\u884c\u8bb0\u5f55\u4e3a\u51c6\uff0c\u5176\u4ed6\u4eba\u6570/\u96be\u5ea6\u53ca250\u5206\u51a0\u519b\u672a\u7a77\u5c3d\u3002", "system_design": "\u53ef\u7f16\u8f91\u539fJavaScript\u542b\u83dc\u5355\u3001\u914d\u7f6e\u3001CGameBase/CGameSingle\u3001CAIManager\u3001\u56de\u5408\u7ba1\u7406\u3001\u724c/\u624b\u724c/\u724c\u5806\u663e\u793a\u3001\u52a8\u753b\u4e0e\u603b\u7ed3\u9762\u677f\uff0c\u9002\u5408\u4e8c\u6b21\u4fee\u6539\u548c\u62c6\u89e3\u9002\u914d\uff1b\u672a\u5b8c\u6210\u8de8\u6e38\u620f\u72ec\u7acb\u79fb\u690d\u9a8c\u8bc1\u3002\u5b8c\u6574PlayerIO\u4f20\u8f93\u3001\u623f\u95f4/\u9080\u8bf7/\u804a\u5929GUI\u3001\u771f\u5b9e\u8054\u7f51\u6a21\u5f0f\u53ca\u7ebf\u4e0a\u5339\u914d\u7684\u6a21\u62dfBot\u5165\u53e3\u9000\u5f79\uff1b\u539f\u72ec\u7acb\u5355\u4eba\u4eba\u673a\u4fdd\u6301\u3002\u5b9e\u9645CrazyGames\u5e7f\u544a/\u6a2a\u5e45/\u4f1a\u8bdd\u4e0a\u62a5\u548c\u5916\u8df3\u65b9\u6cd5\u79fb\u9664\uff0c\u8fd4\u56de\u83dc\u5355\u76f4\u63a5\u4f7f\u7528\u539f\u539f\u751fstartUpdate/gotoMenu\uff0c\u65e0\u5e7f\u544a\u5b8c\u6210\u56de\u8c03\u3001\u5047SDK\u6216\u5956\u52b1\u3002\u539fCreateJS file:-only\u63a2\u6d4b\u4ec5\u6539\u5b9e\u9645XHR\u76ee\u6807\u4e3a\u5f53\u524d\u540c\u6e90\u6587\u6863\uff0c\u771f\u5b9e\u8bf7\u6c42\u4e0e\u72b6\u6001\u5224\u65ad\u4fdd\u6301\uff0c\u9759\u6001HTTP\u8def\u5f84\u4e0d\u6267\u884c\u8be5\u63a2\u6d4b\u3002", "theme": "\u539f\u84dd\u8272\u684c\u9762\u3001\u7ea2\u7eff\u84dd\u9ec4\u7eb8\u724c\u3001\u539f\u529f\u80fd\u724c\u52a8\u753b\u4e0eUNO\u6807\u8bc6\u3001\u539f\u672c\u5730\u56fe\u96c6\u548c\u97f3\u9891\u4fdd\u7559\uff1b\u5c01\u9762\u548c\u8bf4\u660e\u914d\u56fe\u91c7\u7528\u672c\u7248\u672c\u771f\u5b9e\u64cd\u4f5c\u622a\u56fe\u3002\u539f\u56fe\u7247\u7f72\u540d/\u88c5\u9970\u6027MULTIPLAYER\u6587\u5b57\u4fdd\u7559\uff0c\u5b9e\u9645\u8054\u7f51\u6309\u94ae\u4e0e\u529f\u80fd\u5df2\u7ecf\u9000\u5f79\u3002\u6388\u6743\u65b9\uff1agcy\u3002", "progression_economy": "\u539f\u624b\u724c\u7ed3\u679c\u3001\u5404\u73a9\u5bb6\u7d2f\u8ba1\u5206\u6570\u4e0e250\u5206\u80dc\u8d1f\u6784\u6210\u5bf9\u5c40\u8fdb\u5ea6\uff1b\u65e0\u5145\u503c\u3001\u865a\u62df\u5e01\u8d2d\u4e70\u6216\u89c6\u9891\u52a0\u6210\u5546\u5e97\u3002\u6240\u6709\u724c\u9762\u5206\u503c\u3001\u5bf9\u624bAI\u3001\u6b63\u5e38\u6478\u724c/UNO\u60e9\u7f5a\u548c\u539f\u80dc\u5206\u6761\u4ef6\u4fdd\u6301\uff0c\u4e0d\u4ee5\u514d\u8d39\u5956\u52b1\u6216\u4f4e\u96be\u5ea6\u66ff\u4ee3\u7ed3\u7b97\u3002", "roster": "\u539f\u5355\u4eba\u652f\u6301\u73a9\u5bb6\u52a01\u81f33\u4e2a\u672c\u5730\u7535\u8111\u5e2d\u4f4d\uff0c\u4fdd\u7559\u539fCAIManager\u53ca\u4e09\u6863\u96be\u5ea6\u3002\u666e\u901a\u6570\u5b57\u724c\u3001\u53cd\u5411/\u8df3\u8fc7/\u64782\u529f\u80fd\u724c\u548c\u53d8\u8272/\u64784\u724c\u6784\u6210\u53ef\u4ea4\u4e92\u5355\u4f4d\uff1b\u5404\u624b\u724c\u3001\u5f03\u724c\u5806\u3001\u6478\u724c\u5806\u53ca\u539f\u52a8\u753b/\u9ad8\u4eae\u663e\u793a\u4fdd\u6301\uff0c\u6ca1\u6709\u5047\u670d\u52a1\u5668\u73a9\u5bb6\u3002", "monetization": "\u5b9e\u9645SDK\u521d\u59cb\u5316\u3001\u5e7f\u544a/\u6a2a\u5e45\u8c03\u7528\u53ca\u4e8b\u4ef6\u3001\u5b8c\u6574PlayerIO\u63a5\u53e3/Socket/\u623f\u95f4/\u9080\u8bf7/\u8054\u7f51GUI/\u5728\u7ebfBot\u5165\u53e3\u548c\u5916\u90e8\u5bfc\u822a\u5df2\u79fb\u9664\uff1b\u4fdd\u7559\u539f\u5355\u4eba\u7535\u8111AI\uff0c\u6ca1\u6709\u5bf9\u5916\u670d\u52a1\u5668\u8bbf\u95ee\u3001\u5047\u767b\u5f55/\u5e7f\u544a\u6210\u529f\u6216\u5956\u52b1\u3002\u6700\u7ec8\u5b8c\u6574161\u4e2a\u672c\u5730\u8bf7\u6c42\uff0c0\u8bf7\u6c42/\u9875\u9762\u5f02\u5e38\uff0c4\u6761\u539f\u6d4f\u89c8\u5668\u8b66\u544a\u548c\u6b63\u5e38\u8c03\u8bd5\u65e5\u5fd7\u539f\u6837\u4fdd\u7559\uff1b\u6700\u521d\u56e0\u79fb\u9664\u539fPopper\u4f9d\u8d56\u8fc7\u5e7f\u5bfc\u81f4\u4e24\u9879\u542f\u52a8\u5f02\u5e38\uff0c\u5df2\u6062\u590d\u539f\u6587\u4ef6\u53ca\u987a\u5e8f\uff0c\u521d\u59cb\u5931\u8d25\u5355\u72ec\u4fdd\u5168\u3002"}}, "illustrations": [{"path": "screenshots/revision-00-cover.png", "caption": "\u539f\u5355\u4eba\u9ed8\u8ba4\u4e24\u4eba\u3001\u4e2d\u7b49\u96be\u5ea6\u3001\u7279\u6b8a\u6a21\u5f0f\u7684\u56db\u8272\u724c\u684c\u9762"}, {"path": "screenshots/revision-result.png", "caption": "\u540c\u4e00\u624b\u539fSUMMARY\uff1aPlayer2\u83b7\u5f9745\u5206\uff0cPlayer1\u4e3a0\uff0c\u76ee\u6807250\u5206"}, {"path": "screenshots/revision-next.png", "caption": "\u539fNext\u5f00\u59cb\u4e0b\u4e00\u624b\uff0cPlayer2\u7d2f\u8ba145\u5206\u4fdd\u7559"}, {"path": "screenshots/revision-menu.png", "caption": "\u539fQuit\u786e\u8ba4\u540e\u6b63\u5e38\u8fd4\u56de\u5355\u4eba\u83dc\u5355\uff0c\u65e0\u5e7f\u544a\u63a5\u7eed\u7b49\u5f85"}, {"path": "screenshots/revision-reload.png", "caption": "\u5237\u65b0\u540e\u6309\u539f\u9ed8\u8ba4\u91cd\u5f00\uff0c\u4e24\u65b90\u5206\uff1b\u539f+2\u6548\u679c\u81ea\u7136\u6267\u884c"}]}}]}]}
