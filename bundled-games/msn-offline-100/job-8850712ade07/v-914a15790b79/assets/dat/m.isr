<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<stringresources>
    <strings>

      <string id="ONBOARDING_TEXT0">
          <en>Welcome to Tower Defenders</en>
          <es>¡Bienvenido a Tower Defenders</es>
          <de>Willkommen bei Tower Defenders</de>
          <it>Benvenuti a Tower Defenders</it>
          <fr>Bienvenue à Tower Defenders</fr>
          <br>Bem-vindo ao Tower Defenders</br>
          <ru>Добро пожаловать в Защитники Башни</ru>
      </string>

        <string id="ONBOARDING_TEXT1">
           <en>We are under attack!</en>
           <es>¡Nos atacan!</es>
           <de>Wir werden angegriffen!</de>
           <it>Siamo sotto attacco!</it>
           <fr>Nous sommes attaqués !</fr>
           <br>Estamos sendo atacados!</br>
           <ru>На нас напали!</ru>
        </string>

      <string id="ONBOARDING_TEXT2">
             <en>HOLD or TAP on your screen to shoot with your tower!</en>
             <es>¡MANTIENE o PULSA en tu pantalla para disparar con tu torre!</es>
             <de>HALTE oder TAP auf deinem Bildschirm, um mit deinem Turm zu schießen!</de>
             <it>TENERE PREMUTO o FARE TAPPO sullo schermo per sparare con la torre!</it>
             <fr>MAINTENEZ ou TAPEZ sur votre écran pour tirer avec votre tour !</fr>
             <br>SEGURE ou TOQUE na tela para atirar com sua torre!</br>
             <ru>ДЕРЖИТЕ или НАЖМИТЕ на экране, чтобы стрелять из башни!</ru>
      </string>

      <string id="ONBOARDING_TEXT3">
           <en>We need upgrades to defend ourselves!</en>
           <es>¡Necesitamos mejoras para defendernos!</es>
           <de>Wir brauchen Upgrades, um uns zu verteidigen!</de>
           <it>Abbiamo bisogno di aggiornamenti per difenderci!</it>
           <fr>Nous avons besoin d'améliorations pour nous défendre !</fr>
           <br>Precisamos de atualizações para nos defender!</br>
           <ru>Нам нужны улучшения, чтобы защитить себя!</ru>
      </string>

      <string id="ONBOARDING_TEXT4">
            <en>Survive for longest you can!</en>
            <es>¡Sobrevive el mayor tiempo posible!</es>
            <de>Überlebe so lange du kannst!</de>
            <it>Sopravvivi il più a lungo possibile!</it>
            <fr>Survivez le plus longtemps possible !</fr>
            <br>Sobreviva por mais tempo que puder!</br>
            <ru>Выживайте как можно дольше!</ru>
       </string>

       <string id="ONBOARDING_TEXT8">
            <en>Create permanent upgrades using your gems!</en>
            <es>Crea mejoras permanentes con tus gemas.</es>
            <de>Erstelle permanente Upgrades mit deinen Edelsteinen!</de>
            <it>Crea potenziamenti permanenti usando le tue gemme!</it>
            <fr>Crée des améliorations permanentes à l'aide de tes gemmes !</fr>
            <br>Crie atualizações permanentes usando suas gemas!</br>
            <ru>Создавайте постоянные улучшения, используя драгоценные камни!</ru>
       </string>

        <string id="ONBOARDING_TEXT9">
               <en>Lets continue our defense!</en>
               <es>¡Continuemos nuestra defensa!</es>
               <de>Lasst uns unsere Verteidigung fortsetzen!</de>
               <it>Continuiamo la nostra difesa!</it>
               <fr>Continuons à nous défendre !</fr>
               <br>Vamos continuar nossa defesa!</br>
               <ru>Продолжаем оборону!</ru>
          </string>

        <string id="ONBOARDING_TEXT10">
                 <en>Lets continue our defense!</en>
                 <es>¡Continuemos nuestra defensa!</es>
                 <de>Lasst uns unsere Verteidigung fortsetzen!</de>
                 <it>Continuiamo la nostra difesa!</it>
                 <fr>Continuons à nous défendre !</fr>
                 <br>Vamos continuar nossa defesa!</br>
                 <ru>Продолжаем оборону!</ru>
            </string>


