u610f\uff1a\u5b58\u50a8\u54c8\u5e0c\u4e0d\u80fd\u8bc1\u660e\u8fdb\u5ea6\u88ab\u6b63\u786e\u52a0\u8f7d\u3002", "rules": "\u76ee\u6807\uff1a\u7591\u4e3a\u6807\u51c6\u56fd\u9645\u8c61\u68cb\u76ee\u6807\uff08\u5c06\u6740\u5bf9\u65b9\u738b\uff09\uff0c\u672a\u5b9e\u673a\u9a8c\u8bc1\u3002\u6210\u529f/\u5931\u8d25\uff1a\u80dc\u8d1f\u3001\u548c\u68cb\uff08\u903c\u548c\u3001\u4e09\u6b21\u91cd\u590d\u300150 \u6b65\u7b49\uff09\u5224\u5b9a\u672a\u9a8c\u8bc1\u3002\u8ba1\u5206\u516c\u5f0f\uff1a\u672a\u89c2\u5bdf\u5230\u8ba1\u5206\u7cfb\u7edf\uff1bELO 400\u20132200 \u4e3a\u673a\u5668\u4eba\u5f3a\u5ea6\u6863\uff08\u5df2\u67e5\u8bc1\u754c\u9762\u6570\u503c\uff09\uff0c\u662f\u5426\u5f71\u54cd\u73a9\u5bb6\u8bc4\u5206\u672a\u786e\u8ba4\u3002\u5df2\u67e5\u8bc1\u9608\u503c\uff1aELO \u6863\u4f4d 12 \u6863\uff0c\u533a\u95f4 400\u20132200\uff1b\u5176\u4f59\u9608\u503c\u672a\u786e\u8ba4\uff0c\u4e0d\u7f16\u9020\u3002", "systems": "\u5bf9\u8c61\uff08\u6309\u8bc1\u636e\u5f3a\u5f31\u5206\u7ea7\uff09\uff1a\u68cb\u76d8\u4e0e\u68cb\u5b50\uff08\u7531\u5750\u6807\u6807\u7b7e\u4e0e\u54c1\u7c7b\u63a8\u65ad\uff0c\u672a\u89c2\u5bdf\u68cb\u5b50\u6e32\u67d3\uff09\uff1b\u673a\u5668\u4eba Pebble\uff08\u754c\u9762\u6587\u6848\uff0c12 \u6863\u5f3a\u5ea6\uff09\uff1b\u5f00\u5c40\u914d\u7f6e\u5668\uff08\u5b9e\u673a\u9a8c\u8bc1\uff09\u3002\u72b6\u6001\uff1a\u754c\u9762\u5904\u4e8e\u5f00\u5c40\u914d\u7f6e\u6001\uff08\u5b9e\u673a\u9a8c\u8bc1\uff09\uff1b\u5bf9\u5c40\u6001\u3001\u7ed3\u7b97\u6001\u672a\u89c2\u5bdf\u3002\u89e6\u53d1\uff1a\u6309\u94ae\u70b9\u51fb\u4e3a\u5df2\u786e\u8ba4\u8f93\u5165\u65b9\u5f0f\u3002\u7cfb\u7edf\u4ea4\u4e92\uff1a\u914d\u7f6e\u2192\u5f00\u5c40\u2192AI \u5e94\u7b54\u8d70\u5b50\u7684\u94fe\u8def\u4e3a\u5408\u7406\u63a8\u65ad\uff0c\u672a\u5b9e\u673a\u9a8c\u8bc1\uff1b\u4e0e Poki SDK \u7684\u4ea4\u4e92\uff08\u5e7f\u544a\u3001\u6e38\u620f\u4e8b\u4ef6\uff09\u4ec5\u89c1 SDK \u521d\u59cb\u5316\uff0c gameplay \u96c6\u6210\u70b9\u672a\u9a8c\u8bc1\u3002", "ui_flow": "\u5df2\u5b9e\u673a\u89c2\u5bdf\u75