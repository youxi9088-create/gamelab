# External workers only. Never commit real credentials.
PLATFORM_URL=http://127.0.0.1:8765
PLATFORM_TOOL_TOKEN=
# Optional portal administrator login. Set both values to enable login; never commit real credentials.
PORTAL_ADMIN_USERNAME=
PORTAL_ADMIN_PASSWORD=
REPLICA_AI_BASE_URL=
REPLICA_AI_MODEL=
REPLICA_AI_API_KEY=
REPLICA_AI_VISION=0
REPLICA_AI_MAX_CALLS=5
# Executor-specific configuration is documented in executors/README.md.
# Optional path overrides for server:
GIT_BIN=
# Optional runtime locations. Examples only; export variables or configure the service UI.
NODE_BINARY=
BROWSER_EXECUTABLE=
REPLICA_SERVICE_CONFIG=
REPLICA_PACKAGE_SERVICE_DIR=
REPLICA_WECHAT_CACHE_ROOTS=
# Downstream supply remains disabled until real deployment values are supplied.
SUPPLY_PLATFORM_BASE=
SUPPLY_APP_ID=
SUPPLY_APP_SECRET=
SUPPLY_ARCHIVE_DIR=
SUPPLY_ARCHIVE_BASE_URL=
SUPPLY_EXPECTED_FINGERPRINT=
